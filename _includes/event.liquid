---
layout: base
---
<div class="event-meta">
    <h2 class="event-title">{{ title }}</h2>
    <h3 class="event-byline">{{ byline }}</h3>
    <div class="event-details">
        <span class="event-type">{{ type }}</span> |
        <span class="event-author">{{ author}}</span> |
        {% assign event_date = date | formatDate %}
        {% if event_date != "" or time or start_time %}
        <span class="event-date">{{ event_date }}{% if time %} | {{ time }}{% elsif start_time %} | {{ start_time | timeOnly }}{% if end_time %} - {{ end_time | timeOnly }}{% endif %}{% endif %}</span> |
        {% endif %}
        {% if external_location or location %}
        <span class="event-location">{% if external_location %}{{ external_location }}{% else %}{{ location }}{% endif %}</span>
        {% endif %}
    </div>
</div>
<div class="event-layout">
    <div class="event-image">
        <img src="{{ main_image }}/public" alt="{{ title }}">
    </div>
    <div class="event-text">
        {{ content | raw }}
    </div>
</div>
<div class="event-images">
    {%- for image in images -%}
    <img class="image" src="{{ image }}/public" alt="" />
    {%- endfor -%}
</div>