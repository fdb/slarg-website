---
layout: base
---
<div class="event-meta">
    <h2 class="event-title">{{ title }}</h2>
    <h3 class="event-byline">{{ byline }}</h3>
    <div class="event-details">
        {% if type %}<span class="event-type">{{ type }}</span>{% endif %}
        {% if author %}<span class="event-author">{{ author }}</span>{% endif %}
        {% assign event_date = date | longDate %}
        {% if event_date != "" or time or start_time %}
        <span class="event-date"><span class="event-label">Date:</span> {{ event_date }}{% if time %}{% if event_date %}, {% endif %}{{ time }}{% elsif start_time %}{% if event_date %}, {% endif %}{{ start_time | timeOnly }}{% if end_time %} – {{ end_time | timeOnly }}{% endif %}{% endif %}</span>
        {% endif %}
        {% if external_location or location %}
        <span class="event-location"><span class="event-label">Location:</span> {% if external_location %}{{ external_location }}{% else %}{{ location }}{% endif %}</span>
        {% endif %}
    </div>
</div>
<div class="event-layout">
    <div class="event-image">
        <img src="{{ main_image }}/public" alt="{{ title }}">
    </div>
    <div class="event-text">
        {{ content | raw }}
    </div>
</div>
<div class="event-images">
    {%- for image in images -%}
    <img class="image" src="{{ image }}/public" alt="" />
    {%- endfor -%}
</div>