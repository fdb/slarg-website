---
layout: base.liquid
---

<article class="project">

  <h2 class="big-title">OUTREACH PROJECT</h2>
  <h1>{{ title }}</h1>

<div class="project-date">
  <span class="date">
    {{ start_date | Year }}

    {% unless end_date == empty %}
      &ndash; {{ end_date | Year }}
    {% endunless %}

    {% if ongoing == true or ongoing == "true" %}
      &ndash; <span class="status">ongoing</span>
    {% endif %}
  </span>
</div>


  <ul class="info-project">
    {% if people or external_collaborators %}

      <li class="people-link">
        <strong>Researcher(s):</strong>

        {% if people %}
          {% for person_name in people %}

            {% assign person = collections.people | where: "data.person_name", person_name | first %}

            {% if person %}
              <a href="{{ person.url }}">{{ person_name }}</a>
            {% else %}
              {{ person_name }}
            {% endif %}

            {% unless forloop.last %}, {% endunless %}

          {% endfor %}
        {% endif %}


        {% if external_collaborators %}

          {% if people %}, {% endif %}

          {% for collaborator in external_collaborators %}

            {% if collaborator.url %}
              <a href="{{ collaborator.url | prepend: 'https://' | replace_first: 'https://https://', 'https://' }}"
                 target="_blank"
                 rel="noopener noreferrer">
                {{ collaborator.name }}
              </a>
            {% else %}
              {{ collaborator.name }}
            {% endif %}

            {% unless forloop.last %}, {% endunless %}

          {% endfor %}

        {% endif %}

      </li>

    {% endif %}


    {%- comment -%}
    SUPERVISORS
    {%- endcomment -%}

    {% if supervisors or external_supervisors %}

      <li class="people-link">
        <strong>Supervisor(s):</strong>

        {% if supervisors %}

          {% for person_name in supervisors %}

            {% assign person = collections.people | where: "data.person_name", person_name | first %}

            {% if person %}
              <a href="{{ person.url }}">{{ person_name }}</a>
            {% else %}
              {{ person_name }}
            {% endif %}

            {% unless forloop.last %}, {% endunless %}

          {% endfor %}

        {% endif %}


        {% if external_supervisors %}

          {% if supervisors %}, {% endif %}

          {% for collaborator in external_supervisors %}

            {% if collaborator.url %}
              <a href="{{ collaborator.url | prepend: 'https://' | replace_first: 'https://https://', 'https://' }}"
                 target="_blank"
                 rel="noopener noreferrer">
                {{ collaborator.name }}
              </a>
            {% else %}
              {{ collaborator.name }}
            {% endif %}

            {% unless forloop.last %}, {% endunless %}

          {% endfor %}

        {% endif %}

      </li>

    {% endif %}


    {% if project_owner %}

      <li class="people-link">
        <strong>Project owner(s):</strong>

        {% for person_name in project_owner %}

          {% assign person = collections.people | where: "data.person_name", person_name | first %}

          {% if person %}
            <a href="{{ person.url }}">{{ person_name }}</a>
          {% else %}
            {{ person_name }}
          {% endif %}

          {% unless forloop.last %}, {% endunless %}

        {% endfor %}

      </li>

    {% endif %}

{% if partners or external_partners %}
  <li class="people-link">
    <strong>Partner(s):</strong>

    {% assign has_partner = false %}

    {% if partners %}
      {% for person_name in partners %}
        {% if has_partner %}, {% endif %}

        {% assign person = collections.people | where: "data.person_name", person_name | first %}
        {% if person %}
          <a href="{{ person.url }}">{{ person_name }}</a>
        {% else %}
          {{ person_name }}
        {% endif %}

        {% assign has_partner = true %}
      {% endfor %}
    {% endif %}

    {% if external_partners %}
      {% for collaborator in external_partners %}
        {% if has_partner %}, {% endif %}

        {% if collaborator.url %}
          <a href="{{ collaborator.url | prepend: 'https://' | replace_first: 'https://https://', 'https://' }}"
             target="_blank"
             rel="noopener noreferrer">
            {{ collaborator.name }}
          </a>
        {% else %}
          {{ collaborator.name }}
        {% endif %}

        {% assign has_partner = true %}
      {% endfor %}
    {% endif %}
  </li>
{% endif %}


    {%- comment -%}
    PROJECT STAGE
    {%- endcomment -%}

    {% if project_stage %}

      <li>
        <strong>Stage:</strong> {{ project_stage }}
      </li>

    {% endif %}

  </ul>


  {% if main_image %}

    <figure>
      <img
        src="{{ main_image | url }}/public"
        alt="{{ main_image_alt }}"
      />

      <figcaption class="image-block__credits">
        {{ main_image_credits }}
      </figcaption>
    </figure>

  {% endif %}


  <div class="content">
    {{ content | raw }}
  </div>


  {% if gallery %}

    <div class="gallery">

      {% for image in gallery %}

        <div class="image-block">

          <img
            src="{{ image.src | url }}/public"
            alt="{{ image.alt }}"
          />

          <figcaption class="image-block__credits">
            {{ image.caption }}
          </figcaption>

        </div>

      {% endfor %}

    </div>

  {% endif %}


  {% if funding %}
  <div class="funding">
    <h3>Funding</h3>
    <ul>
      {% for f in funding %}
        <li>
          {% if f.link %}
            <a href="{{ f.link }}" target="_blank" rel="noopener noreferrer">
              {{ f.name }}
            </a>
          {% else %}
            {{ f.name }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

</article>